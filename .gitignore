node_modules/
.DS_Store
*.log
__pycache__/

# Output of the data-refresh action — the action publishes this
# directly to the gh-pages branch under /cdn/, never to main.
cdn/

# Generated by scripts/build-expenses-data.mjs (deploy-time aggregate of
# apps/expenses/data/expenses/**) — never commit it.
apps/expenses/data/expenses.json

# Private figures. The repo is public and the site is static, so only the
# encrypted vault.json is committed; these files are its decrypted form and
# stay on whichever machine unlocked them. See scripts/vault.mjs.
apps/forecast/data/*.json
!apps/forecast/data/vault.json
apps/expenses/data/*.json
!apps/expenses/data/vault.json
apps/expenses/data/expenses/
apps/expenses/files/*
!apps/expenses/files/*.enc
